<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="96dp"
    android:background="@drawable/exit_dialog_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/thumbnail_clear_title"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="@string/thumbnail_clear_description"
            android:textColor="@color/muted"
            android:textSize="9sp" />
    </LinearLayout>

    <Button
        android:id="@+id/cancel_clear_thumbnails"
        android:layout_width="76dp"
        android:layout_height="28dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/focus_button_compact"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="@string/cancel"
        android:textColor="@color/white"
        android:textSize="8sp" />

    <Button
        android:id="@+id/confirm_clear_thumbnails"
        android:layout_width="76dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/focus_button_compact"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="@string/delete"
        android:textColor="@color/white"
        android:textSize="8sp" />
</LinearLayout>
