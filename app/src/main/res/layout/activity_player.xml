<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="false" />

    <!-- Degradado desde abajo: el OSD de la pantalla 4 del diseño v1. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_bottom_shade" />

    <!-- Derecha: reloj, fecha, línea técnica real y de dónde viene. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="52dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/player_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="64sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/player_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.2"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/player_tech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:includeFontPadding="false"
            android:textColor="#6BFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/player_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:textColor="#6BFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Izquierda: eyebrow, título, barra cian con perilla, siguiente y ayuda. -->
    <LinearLayout
        android:id="@+id/player_osd"
        android:layout_width="540dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="52dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.2"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="38sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="start"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/player_bar_track"
                android:layout_width="520dp"
                android:layout_height="4dp"
                android:background="#38FFFFFF">

                <View
                    android:id="@+id/player_bar_fill"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:background="@color/cyan_now" />

                <View
                    android:id="@+id/player_knob"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="-7dp"
                    android:background="@drawable/player_knob" />
            </FrameLayout>

            <TextView
                android:id="@+id/player_time"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_width="520dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#B8C4C9"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/player_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:textColor="#B8C4C9"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/player_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:textColor="#6BFFFFFF"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Franja ▲ audio y subtítulos, sobre el OSD. -->
    <LinearLayout
        android:id="@+id/player_tracks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="250dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/player_track_columns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
