<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/video_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="30dp"
        android:paddingTop="56dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp" />

    <Button
        android:id="@+id/options_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/focus_button_compact"
        android:contentDescription="@string/options"
        android:drawableStart="@drawable/ic_settings_small"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:nextFocusDown="@id/video_grid"
        android:padding="8dp"
        android:text="" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:alpha="0.82"
            android:contentDescription="@null"
            android:src="@drawable/ic_server_large" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/searching_servers"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/empty_description"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/searching_servers_description"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/library_progress"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/cyan" />

        <Button
            android:id="@+id/choose_folder_button"
            android:layout_width="200dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/focus_button_compact"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/search_again"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/options_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/options_panel"
        android:layout_width="640dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="@drawable/options_panel_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/options"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/server_option"
                    style="@style/OptionRow"
                    android:drawableStart="@drawable/ic_server_small"
                    android:text="@string/dlna_server" />

                <TextView
                    android:id="@+id/server_value"
                    style="@style/OptionValue" />

                <Button
                    android:id="@+id/discover_option"
                    style="@style/OptionRow"
                    android:text="@string/search_servers" />

                <Button
                    android:id="@+id/folder_option"
                    style="@style/OptionRow"
                    android:enabled="false"
                    android:text="@string/current_remote_folder" />

                <TextView
                    android:id="@+id/folder_value"
                    style="@style/OptionValue" />

                <Button
                    android:id="@+id/thumbnail_option"
                    style="@style/OptionRow"
                    android:text="@string/thumbnails" />

                <TextView
                    android:id="@+id/thumbnail_value"
                    style="@style/OptionValue" />

                <Button
                    android:id="@+id/generate_thumbnails_option"
                    style="@style/OptionRow"
                    android:text="@string/thumbnail_generate_missing" />

                <Button
                    android:id="@+id/regenerate_thumbnails_option"
                    style="@style/OptionRow"
                    android:text="@string/thumbnail_regenerate_folder" />

                <Button
                    android:id="@+id/clear_thumbnails_option"
                    style="@style/OptionRow"
                    android:text="@string/thumbnail_clear_all" />

                <TextView
                    android:id="@+id/thumbnail_progress"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/cancel_thumbnail_scan"
                    style="@style/OptionRow"
                    android:text="@string/cancel"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
