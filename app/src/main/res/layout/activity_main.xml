<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/video_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="30dp"
        android:paddingTop="56dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp" />

    <TextView
        android:id="@+id/app_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:letterSpacing="0.025"
        android:text="VibeDLNA Player"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/options_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/focus_button_compact"
        android:contentDescription="@string/options"
        android:drawableStart="@drawable/ic_settings_small"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:nextFocusDown="@id/video_grid"
        android:padding="8dp"
        android:text="" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:alpha="0.82"
            android:contentDescription="@null"
            android:src="@drawable/ic_server_large" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/searching_servers"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/empty_description"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/searching_servers_description"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/library_progress"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/cyan" />

        <Button
            android:id="@+id/choose_folder_button"
            android:layout_width="200dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/focus_button_compact"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/search_again"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/options_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/options_panel"
        android:layout_width="680dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="@drawable/options_panel_background"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:includeFontPadding="false"
            android:text="@string/options"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:includeFontPadding="false"
                        android:text="@string/library_section"
                        android:textColor="@color/cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/server_option"
                        style="@style/OptionRow"
                        android:drawableStart="@drawable/ic_server_small"
                        android:nextFocusRight="@id/server_artwork_switch"
                        android:text="@string/dlna_server" />

                    <TextView
                        android:id="@+id/server_value"
                        style="@style/OptionValue" />

                    <Button
                        android:id="@+id/discover_option"
                        style="@style/OptionRow"
                        android:nextFocusRight="@id/server_artwork_switch"
                        android:text="@string/search_servers" />

                    <Button
                        android:id="@+id/folder_option"
                        style="@style/OptionRow"
                        android:enabled="false"
                        android:text="@string/current_remote_folder" />

                    <TextView
                        android:id="@+id/folder_value"
                        style="@style/OptionValue" />
                </LinearLayout>
            </ScrollView>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#2638444A" />

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:includeFontPadding="false"
                        android:text="@string/thumbnail_section"
                        android:textColor="@color/cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/server_artwork_switch"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:buttonTint="@color/cyan"
                        android:includeFontPadding="false"
                        android:nextFocusLeft="@id/server_option"
                        android:text="@string/thumbnail_use_server"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="3dp"
                        android:includeFontPadding="false"
                        android:text="@string/thumbnail_frame_position"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/thumbnail_percent_25"
                            style="@style/ThumbnailPercent"
                            android:nextFocusRight="@id/thumbnail_percent_50"
                            android:text="25%" />

                        <Button
                            android:id="@+id/thumbnail_percent_50"
                            style="@style/ThumbnailPercent"
                            android:nextFocusLeft="@id/thumbnail_percent_25"
                            android:nextFocusRight="@id/thumbnail_percent_75"
                            android:text="50%" />

                        <Button
                            android:id="@+id/thumbnail_percent_75"
                            style="@style/ThumbnailPercent"
                            android:nextFocusLeft="@id/thumbnail_percent_50"
                            android:text="75%" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/generate_thumbnails_option"
                        style="@style/OptionRow"
                        android:layout_marginTop="4dp"
                        android:text="@string/thumbnail_generate_missing" />

                    <Button
                        android:id="@+id/regenerate_thumbnails_option"
                        style="@style/OptionRow"
                        android:text="@string/thumbnail_regenerate_folder" />

                    <Button
                        android:id="@+id/clear_thumbnails_option"
                        style="@style/OptionRow"
                        android:text="@string/thumbnail_clear_all" />

                    <TextView
                        android:id="@+id/thumbnail_progress"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:textColor="@color/muted"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/cancel_thumbnail_scan"
                        style="@style/OptionRow"
                        android:text="@string/cancel"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
