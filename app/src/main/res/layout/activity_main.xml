<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="22dp"
        android:paddingEnd="30dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/vibedlna_banner" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="17sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#253D4A50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/folder_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_server_small"
                android:drawablePadding="9dp"
                android:ellipsize="middle"
                android:includeFontPadding="false"
                android:maxWidth="700dp"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="14dp"
                android:background="#566C7A80" />

            <TextView
                android:id="@+id/video_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/options_button"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/focus_button_compact"
                android:drawableStart="@drawable/ic_settings_small"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:nextFocusDown="@id/video_grid"
                android:text="@string/options"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="18dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:alpha="0.9"
            android:contentDescription="@null"
            android:src="@drawable/ic_server_large" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/searching_servers"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/empty_description"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/searching_servers_description"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/library_progress"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/cyan" />

        <Button
            android:id="@+id/choose_folder_button"
            android:layout_width="220dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/focus_button_compact"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/search_again"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/options_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/options_panel"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/options_panel_background"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/options"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/server_option"
            style="@style/OptionRow"
            android:layout_marginTop="20dp"
            android:drawableStart="@drawable/ic_server_small"
            android:text="@string/dlna_server" />

        <TextView
            android:id="@+id/server_value"
            style="@style/OptionValue"
            android:layout_marginTop="-15dp" />

        <Button
            android:id="@+id/discover_option"
            style="@style/OptionRow"
            android:layout_marginTop="4dp"
            android:text="@string/search_servers" />

        <TextView
            style="@style/OptionValue"
            android:layout_marginTop="-15dp"
            android:text="@string/search_network_again" />

        <Button
            android:id="@+id/folder_option"
            style="@style/OptionRow"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:text="@string/current_remote_folder" />

        <TextView
            android:id="@+id/folder_value"
            style="@style/OptionValue"
            android:layout_marginTop="-15dp" />

        <Button
            android:id="@+id/thumbnail_option"
            style="@style/OptionRow"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:text="@string/thumbnails" />

        <TextView
            style="@style/OptionValue"
            android:layout_marginTop="-15dp"
            android:text="@string/frame_at_half" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_info_small"
            android:drawablePadding="9dp"
            android:gravity="center_vertical"
            android:text="@string/privacy_note"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/options_hint"
            android:textColor="#78909C"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
